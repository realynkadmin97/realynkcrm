# Company email domain, such as the part after @ in a Realynk address.
# Leave this empty until you know the domain. The app will not guess it.
REALYNK_EMAIL_DOMAIN=

# First administrator, used only when the domain above is set and no admin exists yet.
# The address must be on that domain. There is no public registration.
REALYNK_BOOTSTRAP_ADMIN_EMAIL=
REALYNK_BOOTSTRAP_ADMIN_NAME=
REALYNK_BOOTSTRAP_ADMIN_PASSWORD=
